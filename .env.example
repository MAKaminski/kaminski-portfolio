# Copy to .env.local for local development, and set the same variables in the
# Vercel project settings for production. Create React App only exposes
# variables prefixed with REACT_APP_, and inlines them at BUILD time — changing
# one in Vercel requires a redeploy to take effect.

# --- PostHog (product analytics) -------------------------------------------
# REQUIRED for analytics. Without it PostHog is skipped entirely and the site
# records nothing. Find it in PostHog under Project settings > Project ID /
# "Project API key". Must also be set in the Vercel project settings.
REACT_APP_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where posthog-js sends events. Defaults to PostHog US cloud.
# Set to /mk-relay to route events through the same-origin reverse proxy in
# vercel.json, which ad blockers don't recognise.
# REACT_APP_POSTHOG_HOST=/mk-relay

# --- Google Analytics 4 -----------------------------------------------------
# Optional. GA is skipped entirely when unset.
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Contact form -----------------------------------------------------------
# Optional. Contact form POSTs here; falls back to a mailto: link when unset.
# REACT_APP_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
