# Copy to .env.local for local development, and set the same variables in the
# Vercel project settings for production.
#
# Create React App only exposes variables prefixed with REACT_APP_, and inlines
# them at BUILD time — changing one in Vercel requires a redeploy to take effect.
#
# Set the VALUE ONLY in the dashboard. Pasting a whole line
# ("REACT_APP_POSTHOG_KEY = phc_...") makes the variable name part of the value.
# That is a real incident here, not a hypothetical: it is how production ended
# up with an unusable PostHog key.

# --- PostHog (product analytics) -------------------------------------------
# REQUIRED. Without it PostHog is disabled and the site records nothing.
# Find it in PostHog under Project settings > "Project API key". Must be a bare
# key: phc_ followed by the token, with no variable name and no quotes.
REACT_APP_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where posthog-js sends events. Defaults to PostHog US cloud.
# Set to /mk-relay to route events through the same-origin reverse proxy in
# vercel.json, which ad blockers don't recognise.
# REACT_APP_POSTHOG_HOST=/mk-relay

# --- Google Analytics 4 -----------------------------------------------------
# Optional. GA is skipped entirely when unset.
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Contact form -----------------------------------------------------------
# Optional. Contact form POSTs here; falls back to a mailto: link when unset.
# REACT_APP_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
