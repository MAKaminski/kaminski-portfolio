# Copy to .env.local for local development, and set the same values in the
# Vercel project settings (Settings -> Environment Variables) for deploys.
#
# Create React App only exposes variables prefixed with REACT_APP_ to the
# browser bundle, and only reads them at build time — changing one in Vercel
# requires a redeploy to take effect.

# PostHog product analytics. This is the *public* project API key (starts with
# "phc_"); it is write-only and ships in the client bundle by design. Find it at
# PostHog -> Settings -> Project -> Project API Key.
# Without this, PostHog is disabled and no visitor data is collected.
REACT_APP_POSTHOG_KEY=

# Optional. PostHog ingestion host. Defaults to https://us.i.posthog.com.
# Only override this if you put a reverse proxy in front of PostHog — note that
# a plain Vercel rewrite will NOT work here (static deploys 405 on POST).
# REACT_APP_POSTHOG_HOST=

# Optional. Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Without this, the GA code in src/utils/analytics.ts stays inert.
# REACT_APP_GA_MEASUREMENT_ID=

# Optional. POST target for the contact form (e.g. a Formspree endpoint).
# Without this, the form falls back to opening the visitor's mail client.
# REACT_APP_CONTACT_ENDPOINT=
