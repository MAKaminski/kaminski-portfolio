{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "michaelkaminski.com" }],
      "destination": "https://www.michael-kaminski.io/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.michaelkaminski.com" }],
      "destination": "https://www.michael-kaminski.io/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "michael-kaminski.io" }],
      "destination": "https://www.michael-kaminski.io/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
