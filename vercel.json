{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "michaelkaminski.com"
        }
      ],
      "destination": "https://www.michael-kaminski.io/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.michaelkaminski.com"
        }
      ],
      "destination": "https://www.michael-kaminski.io/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "michael-kaminski.io"
        }
      ],
      "destination": "https://www.michael-kaminski.io/$1",
      "permanent": true
    },
    {
      "source": "/cfo",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/revenue",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/client-outcomes",
      "destination": "/projects",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/analytics",
      "destination": "/index.html"
    }
  ]
}
